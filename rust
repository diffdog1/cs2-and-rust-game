<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Price Check — Daily Rust Skin Price Game</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  :root{
    --bg:#0a0e15;
    --bg-radial:radial-gradient(ellipse 900px 500px at 50% -10%,#16202f 0%,#0a0e15 55%);
    --surface:#121824;
    --surface-2:#19212f;
    --border:#242e3d;
    --border-soft:#1b2432;
    --text:#eef1f6;
    --muted:#8996a8;
    --muted-2:#5f6b7d;
    --gold:#f0b90b;
    --gold-soft:rgba(240,185,11,.14);
    --danger:#eb4b4b;
    --good:#4fd68c;
    --radius:16px;
    --radius-sm:10px;
    --maxw:560px;
    --font-display:'Rajdhani','Inter',sans-serif;
    --font-body:'Inter',sans-serif;
  }

  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; }

  body{
    background:var(--bg-radial);
    background-color:var(--bg);
    color:var(--text);
    font-family:var(--font-body);
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
    padding-bottom:64px;
  }

  a{ color:var(--gold); }

  .wrap{ max-width:var(--maxw); margin:0 auto; padding:0 18px; }

  .topbar{
    display:flex; align-items:center; justify-content:space-between; padding:20px 0 8px;
  }

  .brand{
    font-family:var(--font-display); font-weight:700; font-size:22px; letter-spacing:.02em;
    display:flex; align-items:center; gap:8px;
  }

  .brand .tag{
    color:var(--bg); background:var(--gold); font-size:11px; font-weight:700;
    padding:2px 7px; border-radius:5px; font-family:var(--font-body); letter-spacing:.03em;
  }

  .streak{
    display:flex; align-items:center; gap:6px; background:var(--surface); border:1px solid var(--border);
    padding:6px 12px; border-radius:999px; font-size:14px; font-weight:600; color:var(--muted);
  }

  .streak b{ color:var(--text); font-family:var(--font-display); font-size:16px; }

  .menu-wrap{ position:relative; display:flex; align-items:center; gap:10px; }

  .menu-btn{
    display:flex; align-items:center; justify-content:center; width:36px; height:36px; flex-shrink:0;
    background:var(--surface); border:1px solid var(--border); border-radius:10px; color:var(--text);
    cursor:pointer; padding:0; transition:background .15s,border-color .15s;
  }

  .menu-btn:hover{ background:var(--surface-2); }
  .menu-btn:focus-visible{ outline:2px solid var(--gold); outline-offset:2px; }

  .menu-dropdown{
    position:absolute; top:46px; right:0; background:var(--surface); border:1px solid var(--border);
    border-radius:var(--radius-sm); min-width:190px; padding:6px; box-shadow:0 16px 34px rgba(0,0,0,.5);
    z-index:30; opacity:0; transform:translateY(-6px); pointer-events:none; transition:opacity .15s ease,transform .15s ease;
  }

  .menu-dropdown.open{ opacity:1; transform:translateY(0); pointer-events:auto; }

  .menu-label{ font-size:11px; color:var(--muted-2); text-transform:uppercase; letter-spacing:.06em; padding:8px 10px 4px; }

  .menu-item{
    display:flex; align-items:center; gap:10px; padding:10px; border-radius:8px; font-size:14px; font-weight:600;
    color:var(--text); cursor:pointer; background:none; border:none; width:100%; text-align:left; font-family:var(--font-body);
  }

  .menu-item:hover{ background:var(--surface-2); }
  .menu-item:focus-visible{ outline:2px solid var(--gold); outline-offset:-2px; }
  .menu-item.active{ color:var(--gold); }
  .menu-item .dot-ind{ width:6px; height:6px; border-radius:50%; background:var(--muted-2); flex-shrink:0; }
  .menu-item.active .dot-ind{ background:var(--gold); }

  .hero{ padding:18px 0 22px; }
  .hero h1{ font-family:var(--font-display); font-size:34px; line-height:1.05; margin:0 0 8px; font-weight:700; }
  .hero p{ margin:0; color:var(--muted); font-size:15px; line-height:1.5; max-width:44ch; }
  .hero .day-label{ display:inline-block; font-size:12px; color:var(--muted-2); letter-spacing:.04em; margin-bottom:10px; }

  .dots{ display:flex; gap:7px; justify-content:center; margin-bottom:18px; }
  .dot{ width:8px; height:8px; border-radius:50%; background:var(--border); transition:background .25s,transform .25s; }
  .dot.done{ background:var(--gold); }
  .dot.current{ background:var(--text); transform:scale(1.3); }

  .card{
    background:var(--surface); border:1px solid var(--border); border-radius:var(--radius);
    padding:22px; position:relative; overflow:hidden;
  }

  .spotlight{
    position:relative; height:200px; display:flex; align-items:center; justify-content:center;
    margin-bottom:6px; border-radius:var(--radius-sm); background:var(--surface-2); overflow:hidden;
  }

  .spotlight .glow{
    position:absolute; inset:0;
    background:radial-gradient(circle at 50% 55%, var(--glow-color,#46536633) 0%, transparent 62%);
    transition:background .5s ease;
  }

  .icon-emoji{
    position:relative;
    font-size:88px;
    line-height:1;
    z-index:2;
    filter:drop-shadow(0 8px 18px rgba(0,0,0,.5));
    transform:scale(1);
    transition:transform .2s ease;
  }

  .item-meta{ text-align:center; margin:14px 0 20px; }
  .item-name{ font-family:var(--font-display); font-size:21px; font-weight:700; margin-bottom:4px; }
  .item-wear{ color:var(--muted); font-size:13px; letter-spacing:.02em; }

  .rarity-pill{
    display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600; padding:3px 10px;
    border-radius:999px; margin-top:8px; border:1px solid var(--rarity-color,var(--border)); color:var(--rarity-color,var(--muted));
  }

  .rarity-pill .sw{ width:7px; height:7px; border-radius:50%; background:var(--rarity-color,var(--muted)); }

  .guess-row{
    display:flex; align-items:stretch; gap:0; border:1px solid var(--border); border-radius:var(--radius-sm);
    overflow:hidden; background:var(--bg);
  }

